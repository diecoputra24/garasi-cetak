generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String       @default("user")
  accounts      Account[]
  invitations   Invitation[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Invitation {
  id             String    @id @default(cuid())
  slug           String    @unique
  userId         String
  themeId        String
  status         String    @default("active")
  brideName      String?
  brideShort     String?
  groomName      String?
  groomShort     String?
  genderFirst    String?
  brideParents   String?
  groomParents   String?
  akadDate       DateTime?
  akadTime       String?
  akadPlace      String?
  akadAddress    String?
  akadMaps       String?
  resepsiDate    DateTime?
  resepsiTime    String?
  resepsiPlace   String?
  resepsiAddress String?
  resepsiMaps    String?
  gallery        String?
  gifts          String?
  musicUrl       String?
  story          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  brideImage     String?
  brideInstagram String?
  groomImage     String?
  groomInstagram String?
  views          Int       @default(0)
  guests         Guest[]
  theme          Theme     @relation(fields: [themeId], references: [id])
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvps          RSVP[]
  wishes         Wish[]
  visitLogs      VisitLog[]

  @@map("invitation")
}

model VisitLog {
  id           String     @id @default(cuid())
  invitationId String
  ipAddress    String?
  userAgent    String?
  deviceType   String?    // Mobile, Desktop, Tablet
  referrer     String?
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("visit_log")
}

model Guest {
  id           String     @id @default(cuid())
  name         String
  phoneNumber  String?
  invitationId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("guest")
}

model RSVP {
  id           String     @id @default(cuid())
  name         String
  total        Int
  status       String
  invitationId String
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("rsvp")
}

model Wish {
  id           String     @id @default(cuid())
  name         String
  message      String
  invitationId String
  createdAt    DateTime   @default(now())
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("wish")
}

model Theme {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  previewUrl  String?
  category    String       @default("floral")
  invitations Invitation[]

  @@map("theme")
}

model Jwks {
  id         String   @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())

  @@map("jwks")
}
