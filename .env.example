# Better Auth Configuration
BETTER_AUTH_SECRET="your-very-secure-random-secret-here"

# Application Base URL (Match your access method)
# BETTER_AUTH_URL=http://localhost:3000                 # Local development
# BETTER_AUTH_URL=http://192.168.99.202:3000            # Ubuntu Server IP
# BETTER_AUTH_URL=http://103.39.51.109:202              # Public WAN IP
BETTER_AUTH_URL=https://your-domain.com                # Final Domain

# Trusted Origins (Comma separated URLs for CORS/CSRF protection)
# Useful when accessing via reverse proxy or multiple IPs
TRUSTED_ORIGINS="http://localhost:3000,http://192.168.99.202:3000,http://103.39.51.109:202"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/garasicetak?schema=public"
